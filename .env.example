# Copy to .env and replace locally. Never commit .env or share the real key.
ALPHAVANTAGE_API_KEY=replace_with_your_key
# Conservative request pacing. Match your actual Alpha Vantage plan.
ALPHAVANTAGE_MIN_INTERVAL_MS=1100
PORT=3000

